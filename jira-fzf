#!/usr/bin/env bash

# Capture the current git branch (suppress errors if not in a git repo)
CURRENT_BRANCH=$(git branch --show-current 2>/dev/null)

# 1. Fetch issues and build exact columns using sed, awk (for sorting), & column
FZF_OUT=$(jira issue list \
    --jql "assignee = currentUser() AND sprint in openSprints() AND status in ('Selected for Development', 'In Progress', 'In Review')" \
    --columns "KEY,STATUS,PRIORITY,SUMMARY" \
    --plain \
    --no-headers \
    --no-truncate | \
    sed -E 's/[[:space:]]+(Selected for Development|In Progress|In Review)[[:space:]]{2,}/\t\1\t/' | \
    sed -E 's/\t(Highest|High|Medium|Low|Lowest)[[:space:]]{2,}/\t\1\t/' | \
    sed -E 's/\tMedium\t/\tM\t/; s/\tHigh\t/\tH\t/; s/\tHighest\t/\tH\t/; s/\tLow\t/\tL\t/; s/\tLowest\t/\tL\t/' | \
    awk -F'\t' -v branch="$CURRENT_BRANCH" '{
        weight = 4
        if ($1 == branch) weight = 0
        else if ($2 == "In Progress") weight = 1
        else if ($2 == "In Review") weight = 2
        else if ($2 == "Selected for Development") weight = 3
        
        # Prepend the weight to the line for sorting
        print weight "\t" $0
    }' | \
    sort -n -k1,1 | \
    cut -f2- | \
    column -s $'\t' -t | \
    fzf --prompt="Select Issue > " \
        --header="Shortcuts: Enter (Menu) | C-b (Branch) | C-u (PR) | C-o (Open)" \
        --expect=ctrl-b,ctrl-u,ctrl-o,enter \
        --preview="jira issue view {1}" \
        --preview-window=right:50%)

# Exit if the user pressed ESC or aborted
if [[ -z "$FZF_OUT" ]]; then
    echo "Action cancelled."
    exit 0
fi

# Extract the pressed key (line 1) and the selected issue (line 2+)
KEY=$(echo "$FZF_OUT" | head -n 1)
SELECTED_LINE=$(echo "$FZF_OUT" | tail -n +2)

if [[ -z "$SELECTED_LINE" ]]; then
    exit 0
fi

# Extract the issue key (the first column)
ISSUE_KEY=$(echo "$SELECTED_LINE" | awk '{print $1}')

# Determine the action based on the shortcut pressed on the MAIN screen
if [[ "$KEY" == "ctrl-b" ]]; then
    ACTION="Branch"
elif [[ "$KEY" == "ctrl-u" ]]; then
    ACTION="PR"
elif [[ "$KEY" == "ctrl-o" ]]; then
    ACTION="Open"
else
    # 2. They pressed Enter, so show the fallback action menu
    MENU_OUT=$(printf "Move\nReassign\nOpen\nBranch\nPR\nCancel" | \
        fzf --prompt="Action for $ISSUE_KEY > " \
            --header="Shortcuts: C-b (Branch) | C-u (PR) | C-o (Open)" \
            --expect=ctrl-b,ctrl-u,ctrl-o,enter)

    if [[ -z "$MENU_OUT" ]]; then
        echo "Action cancelled."
        exit 0
    fi

    SUB_KEY=$(echo "$MENU_OUT" | head -n 1)
    SUB_SEL=$(echo "$MENU_OUT" | tail -n +2)

    # Determine the action based on the shortcut pressed on the SECONDARY screen
    if [[ "$SUB_KEY" == "ctrl-b" ]]; then
        ACTION="Branch"
    elif [[ "$SUB_KEY" == "ctrl-u" ]]; then
        ACTION="PR"
    elif [[ "$SUB_KEY" == "ctrl-o" ]]; then
        ACTION="Open"
    else
        ACTION="$SUB_SEL"
    fi
fi

# 3. Execute the matched action
case "$ACTION" in
    "Move")
        jira issue move "$ISSUE_KEY"
        ;;
    "Reassign")
        jira issue assign "$ISSUE_KEY"
        ;;
    "Open")
        jira open "$ISSUE_KEY"
        ;;
    "Branch")
        # Check for uncommitted changes
        if [[ -n $(git status --porcelain) ]]; then
            echo "Warning: You have uncommitted changes in your working directory."
            
            # Present a sub-menu to handle the dirty state
            STASH_ACTION=$(printf "stash and continue\ncancel" | fzf --prompt="Uncommitted changes detected > ")
            
            case "$STASH_ACTION" in
                "stash and continue")
                    echo "Stashing changes..."
                    git stash push -m "Auto-stash before switching to $ISSUE_KEY"
                    ;;
                *)
                    echo "Action cancelled. Please commit or stash your changes manually."
                    exit 0
                    ;;
            esac
        fi

        # Check if the branch already exists locally
        if git show-ref --verify --quiet "refs/heads/$ISSUE_KEY"; then
            echo "Branch '$ISSUE_KEY' already exists locally. Switching to it..."
            git checkout "$ISSUE_KEY"
        else
            echo "Fetching latest develop from origin..."
            git fetch origin develop
            
            echo "Creating and checking out branch '$ISSUE_KEY' from origin/develop..."
            git checkout -b "$ISSUE_KEY" origin/develop
        fi
        ;;
    "PR"|"Pr") 
        echo "Checking Bitbucket for an existing PR..."
        
        # We use awk '/^#/' to strictly match lines starting with # (the PR title line)
        PR_ID=$(bkt pr list --mine 2>/dev/null | grep "$ISSUE_KEY" | awk '/^#/ {print $1}' | sed 's/#//' | head -n 1)
        
        # Dynamically extract Workspace and Repo name from Git config
        REMOTE_URL=$(git config --get remote.origin.url)
        
        if [[ -z "$REMOTE_URL" ]]; then
            echo "Error: Could not determine git remote origin url. Are you in a git repository?"
            exit 1
        fi
        
        # Strip everything up to "bitbucket.org/" or "bitbucket.org:" and remove the ".git" suffix
        PATH_PART=$(echo "$REMOTE_URL" | sed -E 's/.*bitbucket\.org[:\/](.*)/\1/' | sed 's/\.git$//')
        
        # Split into workspace and repo variables
        WORKSPACE_UUID=$(echo "$PATH_PART" | cut -d'/' -f1)
        REPO_UUID=$(echo "$PATH_PART" | cut -d'/' -f2)
        WEB_URL="https://bitbucket.org/${WORKSPACE_UUID}/${REPO_UUID}"
        
        if [[ -n "$PR_ID" ]]; then
            echo "Found existing PR #$PR_ID!"
            PR_URL="$WEB_URL/pull-requests/$PR_ID"
        else
            echo "No existing PR found. Opening PR creation page..."
            PR_URL="$WEB_URL/pull-requests/new?source=$ISSUE_KEY"
            echo "[packages/playwright-tests/test/smoke]" | pbcopy
        fi
        
        echo "Opening: $PR_URL"
        
        # Open URL based on OS
        if command -v open &> /dev/null; then
            open "$PR_URL"        # macOS
        elif command -v xdg-open &> /dev/null; then
            xdg-open "$PR_URL"    # Linux
        elif command -v start &> /dev/null; then
            start "$PR_URL"       # Windows
        else
            echo "Please open this link manually:"
            echo "$PR_URL"
        fi
        ;;
    "Cancel"|"")
        echo "Action cancelled."
        exit 0
        ;;
    *)
        echo "Action cancelled."
        exit 0
        ;;
esac
