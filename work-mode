#!/usr/bin/env bash

set -e

MODE="${1:-}"

if [[ "$MODE" != "on" && "$MODE" != "off" ]]; then
  echo "Usage: $0 [on|off]"
  exit 1
fi

quit_app() {
  local app="$1"
  # echo "Quitting $app..."
  osascript -e "tell application \"$app\" to quit" 2>/dev/null || true
  sleep 0.5
  pkill -ix "$app" 2>/dev/null || true
}

move_app_to_ws() {
  local app="$1" ws="$2" id=""
  for _ in {1..40}; do
    id="$(aerospace list-windows --all --format '%{window-id} %{app-name}%{newline}' \
      | awk -v a="$app" '$2==a{print $1}' | tail -n1)"
    [[ -n "$id" ]] && break
    sleep 0.25
  done
  [[ -n "$id" ]] && aerospace move-node-to-workspace --window-id "$id" "$ws"
}

if [[ "$MODE" == "on" ]]; then
  quit_app "LibreWolf"
  open -na "Chromium"
  move_app_to_ws "Chromium" "2"
  open -na "Slack"
  move_app_to_ws "Slack" "4"
  open -na "Twingate"
  defaultbrowser chromium
  ~/scripts/tmux-sessionizer ~/projects/work/signus/signus-ui
else
  quit_app "Chromium"
  quit_app "Slack"
  quit_app "Twingate"
  open -na "LibreWolf"
  move_app_to_ws "LibreWolf" "2"
  defaultbrowser librewolf
  ~/scripts/tmux-sessionizer ~
fi
